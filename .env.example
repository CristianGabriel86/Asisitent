# Exemplu fără secrete. Variabilele trebuie injectate în proces, nu este încărcat automat.
# AISTENT_AI_KEY se introduce în secret manager, niciodată în Git sau chat.
AISTENT_DATA_DIR=./instance
AISTENT_ALLOW_REGISTRATION=1
AISTENT_SECURE_COOKIES=0
AISTENT_TEXT_MODEL=gpt-4.1-mini
AISTENT_IMAGE_MODEL=gpt-image-1
# Estimări USD / cerere, stabilite de administrator după verificarea tarifelor.
# 0 = funcție dezactivată. Valorile de aici NU reprezintă tarife ale furnizorului.
AISTENT_COST_CHAT_USD=0
AISTENT_COST_SEARCH_USD=0
AISTENT_COST_IMAGE_GENERATE_USD=0
AISTENT_COST_IMAGE_EDIT_USD=0
AISTENT_COST_VIDEO_GENERATE_USD=0
AISTENT_COST_VIDEO_EDIT_USD=0

# Clé video: AISTENT_VIDEO_KEY în secret manager (Replicate).
# Versiuni reale din pagina API a modelului ales; nu inventa identificatori.
AISTENT_VIDEO_GENERATE_VERSION=
AISTENT_VIDEO_EDIT_VERSION=
# Copiază schema exactă a modelului; valorile de mai jos sunt doar substituenți.
# AISTENT_VIDEO_GENERATE_INPUT={"prompt":"$PROMPT","image":"$IMAGE"}
# AISTENT_VIDEO_EDIT_INPUT={"prompt":"$PROMPT","video":"$VIDEO"}
# Plafoane locale zilnice pe estimări; nu înlocuiesc limitele furnizorilor.
AISTENT_DAILY_USER_ESTIMATE_USD=5
AISTENT_DAILY_GLOBAL_ESTIMATE_USD=20
